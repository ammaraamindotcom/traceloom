# Local development only. Do not commit a real .env file.
TRACELOOM_ENV=development
DATABASE_URL=postgresql+psycopg://traceloom:change-me@localhost:5432/traceloom
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep these backend-only. Do not create VITE_ equivalents.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
INTENT_ACCESS_TOKEN=

# Production defaults are intentionally conservative.
INTENT_RATE_LIMIT_REQUESTS=3
INTENT_RATE_LIMIT_WINDOW_SECONDS=3600
WRITE_RATE_LIMIT_REQUESTS=30
WRITE_RATE_LIMIT_WINDOW_SECONDS=3600
